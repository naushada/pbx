# Dockerfile.test — Layer 0 test build for onprem-pbx.
#
# Uses the cached `pbx-cpp-builder:bootstrap` image (a tagged snapshot of
# xpmile's cpp-builder stage with ACE/TAO 7.0.0 and googletest already built
# under /usr/local). This shaves ~30 min off the first build during Layer 0
# bring-up. A from-scratch Dockerfile mirroring xpmile's full cpp-builder is
# added in a later layer per DESIGN.md §12.
FROM localhost/pbx-cpp-builder:bootstrap

WORKDIR /src
COPY CMakeLists.txt /src/
COPY modules/      /src/modules/
COPY pbx-agent/    /src/pbx-agent/
COPY test/         /src/test/

WORKDIR /src/build
RUN cmake -DBUILD_TESTS=ON .. \
 && make -j"$(nproc)" offtarget

WORKDIR /src/build/test
# Three inherited xpmile tests depend on a live MongoDB or have drifted
# from xpmile production code (they fail in xpmile too). Documented in
# README.md (Status > Skipped tests). Override --gtest_filter to include
# them once a Mongo fixture is wired up.
CMD ["./offtarget", "--gtest_color=yes", \
     "--gtest_filter=-AccountLoginTest.ValidCredentials_Returns200WithAccountData:AccountLoginTest.ResponseBody_ExcludesSensitiveFields:WsDbServer.SecondAgentRejected_When_FirstAlive"]
