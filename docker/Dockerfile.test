# Dockerfile.test — Layer 0 test build for onprem-pbx.
#
# Uses the cached `pbx-cpp-builder:bootstrap` image (a tagged snapshot of
# xpmile's cpp-builder stage with ACE/TAO 7.0.0 and googletest already built
# under /usr/local). This shaves ~30 min off the first build during Layer 0
# bring-up. A from-scratch Dockerfile mirroring xpmile's full cpp-builder is
# added in a later layer per DESIGN.md §12.
#
# BUILDER_IMAGE override: see Dockerfile.agent for the three-context
# rationale. Local dev keeps the localhost/ default; CI overrides to
# docker.io/naushada/pbx-cpp-builder:bootstrap.
ARG BUILDER_IMAGE=localhost/pbx-cpp-builder:bootstrap
FROM ${BUILDER_IMAGE}

WORKDIR /src
COPY CMakeLists.txt /src/
COPY modules/      /src/modules/
COPY pbx-agent/    /src/pbx-agent/
COPY test/         /src/test/
# SeedDataTest.BootstrapAdminHasHashedPassword reads /src/install.sh
# to verify the bootstrap admin's seed line uses portalPasswordHash +
# `$pbkdf2-sha256$` modular-crypt form, not a plain-text password.
COPY install.sh    /src/install.sh
# pjsip_template_drift_test reads docker/asterisk/pjsip.conf to verify
# the inlined endpoint fields in PjsipProvisioner match the
# [endpoint-resident-template] section. Skips gracefully if missing
# (dev machines running tests outside this image).
COPY docker/      /src/docker/
# innertls_test reads server.crt/server.key (and client.crt/key for
# the mTLS PeerSubjectCn tests) from /src/certs/. Only the project CA
# cert + generate.sh are committed — the *.key files are gitignored
# — so a fresh checkout (CI, another dev machine) has nothing for
# COPY to bring in. Without keys the suite's SetUp calls
# GTEST_SKIP and all 10 InnerTls tests silently pass-as-skipped,
# which makes any handshake regression invisible.
#
# Run generate.sh INSIDE the image to mint a fresh test-only triple
# every build. Keys live only in this image, never on disk or in git;
# rebuilding the image rotates them, and the openssl version that
# generates them is the same one the tests link against (so there's
# no host vs container cipher mismatch to chase). Dev machines
# running `cmake; ctest` outside this image still skip gracefully —
# that's intentional, the comment on the GTEST_SKIP describes it.
COPY certs/innertls/ /src/certs/
RUN cd /src/certs && bash generate.sh > /dev/null

WORKDIR /src/build
RUN cmake -DBUILD_TESTS=ON -DBUILD_BINARIES=ON .. \
 && make -j"$(nproc)" offtarget pbx-agent pbx-cloud

WORKDIR /src/build/test
# All offtarget tests now run unfiltered. Recently retired:
#
#   - WsDbServer.SecondAgentRejected_When_FirstAlive — was filtered
#     as "timing-sensitive in the upstream xpmile library". Real
#     bug: the test asserted the server sent 409 Conflict to the
#     second agent, but production `WsDbServer::on_agent_connected`
#     now evicts the (stale) first agent via `::shutdown(SHUT_RDWR)`
#     and tells the second to back off with 503 + Retry-After: 2.
#     The 409 path still exists in the parallel TLS-accept loop in
#     `svc()`, but `on_agent_connected` itself moved to the
#     eviction-and-retry shape. Test asserts the new contract; the
#     .hpp docstring updated to match, 2026-05-29.
#   - AccountLoginTest.ValidCredentials_Returns200WithAccountData
#     + AccountLoginTest.ResponseBody_ExcludesSensitiveFields — were
#     mislabelled as "needs live Mongo" but the underlying bug was a
#     test-fixture schema mismatch: the JSON fixtures seeded
#     `passwordHash` at the top level of the account doc, but
#     `handle_account_login_POST` reads it from
#     `loginCredentials.passwordHash` (webservice.cpp:1003 — the same
#     path `migrate_account_passwords` writes to). Hash nested under
#     loginCredentials; both tests pass without a live DB, 2026-05-29.
#   - SeedDataTest.BootstrapAdminHasHashedPassword — was filtered
#     because the test read /src/docker/mongo-init.js which onprem-pbx
#     doesn't ship; recast to read /src/install.sh's
#     `db.subscribers.replaceOne(...)` admin seed instead (PR added
#     `COPY install.sh /src/install.sh` to this Dockerfile), 2026-05-29.
#   - MicroServiceRouting.RoutesSubscriberImportTemplateGET — was
#     filtered because the POST half of the test hit the admin-only
#     /import route without a session token; fix was to seed an admin
#     session + include ?token=admin-tok in the URL (same pattern as
#     RoutesSubscriberImportPost), 2026-05-23.
CMD ["./offtarget", "--gtest_color=yes"]
