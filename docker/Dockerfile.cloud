# Dockerfile.cloud — production Heroku-side pbx-cloud image.
#
# Three stages following xpmile's pattern (DESIGN.md §11 — "Angular UI
# bundled inside cloud image"):
#   1. cpp-builder — compiles the pbx-cloud binary against the cached
#                    pbx-cpp-builder:bootstrap toolchain.
#   2. ui-builder  — runs `ng build` on the Angular sources.
#   3. runtime     — slim Ubuntu with the binary + UI bundle. The
#                    webservice serves the SPA from ../webgui/webui/
#                    (relative to /opt/pbx-cloud) using the static-file
#                    handler in webservice.cpp (inherited from xpmile).
#
# Build:        podman build --platform linux/amd64 -f docker/Dockerfile.cloud -t onprem-pbx-cloud:latest .
# Heroku push:  see ./deploy-heroku.sh

# ============================================================
# Stage 1: C++ binary.
# ============================================================
# BUILDER_IMAGE: see Dockerfile.agent for the three-context rationale.
ARG BUILDER_IMAGE=localhost/pbx-cpp-builder:bootstrap
FROM ${BUILDER_IMAGE} AS cpp-builder

WORKDIR /src
COPY CMakeLists.txt /src/
COPY modules/      /src/modules/
COPY test/         /src/test/

# ── InnerTLS material — fresh CA + server + 2× client per build ────
#
# Self-contained: NO certs flow in from the repo. Each build mints a
# brand-new CA, a server cert (the cloud's identity), and TWO client
# certs — one for pbx-wsdbagent (`/ws/db` tunnel) and one for pbx-agent
# (`/agent` SIP tunnel). All four are signed by the same fresh CA, so
# every peer of the deployed cloud is on a matched chain — no drift
# possible between the cloud's CA and what the on-prem peers present.
#
# Three artifact sets land in `/src/`:
#   /src/certs/             — ca.crt + server.{crt,key}    (baked into runtime)
#   /src/agent-certs/       — ca.crt + client.{crt,key}    (pbx-wsdbagent client; extracted by deploy)
#   /src/sip-agent-certs/   — cloud-ca.pem + agent.{crt,key} (pbx-agent client;
#                              same per-deploy extraction). The filenames match
#                              what pbx-agent/src/main/main.cpp expects at the
#                              CERTS_DIR mount path so no agent code change is
#                              needed.
#
# ca.key is consumed during signing and deleted before any other
# layer can see it — no signing capability survives the cert-baking
# step.
RUN mkdir -p /src/certs /src/agent-certs /src/sip-agent-certs && cd /tmp && \
    # --- CA ---
    openssl genrsa -out ca.key 4096 && \
    openssl req -new -x509 -days 3650 -key ca.key -out ca.crt \
        -subj "/O=onprem-pbx/CN=onprem-pbx-CA" && \
    # --- Server: cloud's identity (verified by every client's CN check) ---
    openssl genrsa -out server.key 4096 && \
    openssl req -new -key server.key -out server.csr \
        -subj "/O=onprem-pbx/CN=pabx.herokuapp.com" && \
    openssl x509 -req -days 3650 -in server.csr \
        -CA ca.crt -CAkey ca.key -CAcreateserial -out server.crt && \
    # --- Client: wsdbagent's identity (/ws/db inner TLS leaf) ---
    openssl genrsa -out client.key 4096 && \
    openssl req -new -key client.key -out client.csr \
        -subj "/O=onprem-pbx/CN=pbx-wsdbagent" && \
    openssl x509 -req -days 3650 -in client.csr \
        -CA ca.crt -CAkey ca.key -CAcreateserial -out client.crt && \
    # --- Client: pbx-agent's identity (/agent SIP tunnel mTLS + inner TLS) ---
    openssl genrsa -out agent.key 4096 && \
    openssl req -new -key agent.key -out agent.csr \
        -subj "/O=onprem-pbx/CN=pbx-agent" && \
    openssl x509 -req -days 3650 -in agent.csr \
        -CA ca.crt -CAkey ca.key -CAcreateserial -out agent.crt && \
    # --- Place artifacts + scrub the CA private key ---
    cp ca.crt /src/certs/ca.crt && \
    mv server.crt server.key /src/certs/ && \
    cp ca.crt /src/agent-certs/ca.crt && \
    mv client.crt client.key /src/agent-certs/ && \
    cp ca.crt /src/sip-agent-certs/cloud-ca.pem && \
    mv agent.crt agent.key /src/sip-agent-certs/ && \
    rm -f ca.key ca.srl server.csr client.csr agent.csr

WORKDIR /src/build
RUN cmake -DBUILD_TESTS=OFF -DBUILD_BINARIES=ON .. \
 && make -j"$(nproc)" pbx-cloud

# ============================================================
# Stage 2: Angular UI bundle (output: /ui/dist/pbxui).
# ============================================================
FROM docker.io/library/node:16-alpine AS ui-builder

WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm install --legacy-peer-deps --no-audit --no-fund

COPY ui/ ./
# Dev configuration is used so the build fits within podman-machine
# memory under amd64 emulation; the output JS is identical in shape,
# only minification/optimisation differs. Switch to `production` once
# we run on a real x86_64 builder with >=6 GB RAM.
RUN npx ng build --configuration development

# ============================================================
# Stage 3: slim runtime — binary + UI bundle.
# ============================================================
FROM ubuntu:focal AS runtime

ENV TZ=Asia/Calcutta DEBIAN_FRONTEND=noninteractive
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl1.1 \
        libboost-filesystem1.71.0 \
        libboost-system1.71.0 \
        libboost-thread1.71.0 \
        libzstd1 \
        libsasl2-2 \
        zlib1g \
        libicu66 \
        tini \
 && rm -rf /var/lib/apt/lists/*

COPY --from=cpp-builder /usr/local/ACE_TAO-7.0.0/lib/   /usr/local/ACE_TAO-7.0.0/lib/
RUN echo "/usr/local/ACE_TAO-7.0.0/lib" > /etc/ld.so.conf.d/ace-tao.conf
COPY --from=cpp-builder /usr/local/lib/libmongoc-1.0.so*  /usr/local/lib/
COPY --from=cpp-builder /usr/local/lib/libbson-1.0.so*    /usr/local/lib/
COPY --from=cpp-builder /usr/local/lib/libmongocxx.so*    /usr/local/lib/
COPY --from=cpp-builder /usr/local/lib/libbsoncxx.so*     /usr/local/lib/
RUN ldconfig

RUN mkdir -p /opt/pbx-cloud/certs /opt/pbx-cloud/agent-certs \
             /opt/pbx-cloud/vapid /opt/webgui/webui
COPY --from=cpp-builder /src/build/pbx-cloud /opt/pbx-cloud/pbx-cloud

# InnerTLS material baked into the cloud image. ca.crt is the shared
# CA both peers verify against; server.{crt,key} is the cloud's
# identity (CN = pabx.herokuapp.com).
COPY --from=cpp-builder /src/certs/ca.crt     /opt/pbx-cloud/certs/ca.crt
COPY --from=cpp-builder /src/certs/server.crt /opt/pbx-cloud/certs/server.crt
COPY --from=cpp-builder /src/certs/server.key /opt/pbx-cloud/certs/server.key

# Matching pbx-wsdbagent client cert family. Carried in the image
# only so `deploy-heroku.sh cmd_extract_agent_certs` can pull it out
# post-build to the operator's disk — the running cloud process does
# NOT use these files. Path: /opt/pbx-cloud/agent-certs/{ca,client}.{crt,key}.
COPY --from=cpp-builder /src/agent-certs/ /opt/pbx-cloud/agent-certs/

# Matching pbx-agent client cert family for the /agent SIP tunnel.
# Same per-deploy extraction as agent-certs above, just a different
# leaf and the filenames pbx-agent's main.cpp expects
# (cloud-ca.pem + agent.{crt,key}). The running cloud process does NOT
# use these files.
COPY --from=cpp-builder /src/sip-agent-certs/ /opt/pbx-cloud/sip-agent-certs/

# UI bundle. The webservice's static-file handler resolves to
# `../webgui/webui/<path>` relative to its WORKDIR (see
# modules/module/webservice/src/webservice.cpp). This path is inherited
# verbatim from xpmile so it stays in sync between projects.
COPY --from=ui-builder /ui/dist/pbxui/ /opt/webgui/webui/

# Operator-facing static assets the cloud streams via REST handlers
# (currently just the XLSX subscriber-import template). Lives at
# /opt/docs/ so a `../docs/...` lookup from WORKDIR=/opt/pbx-cloud
# resolves correctly — same pattern as ../webgui/webui above.
COPY docs/ /opt/docs/

WORKDIR /opt/pbx-cloud

# Heroku injects $PORT at runtime; we default to 8080 for local dev.
# The cloud server is a single binary that takes everything via flags.
# REMOTE_DB selects wsdbagent-tunneled Mongo (the production mode);
# leave blank for local Mongo via --mongo-db-uri.
ENV PORT="8080" \
    SERVER_WORKER="5" \
    DB_URI="" \
    DB_POOL="50" \
    DB_NAME="pabx" \
    REMOTE_DB="" \
    AGENT_PORT="" \
    TLS_CERT="/opt/pbx-cloud/certs/server.crt" \
    TLS_KEY="/opt/pbx-cloud/certs/server.key" \
    TLS_CA="/opt/pbx-cloud/certs/ca.crt" \
    VAPID_KEY_PATH="" \
    VAPID_PRIVATE_KEY_B64="" \
    VAPID_SUBJECT=""

# Heroku has no persistent FS, so the VAPID private PEM is shipped as a
# base64-encoded config var and materialised to /tmp at startup. If
# VAPID_PRIVATE_KEY_B64 is set it wins over any inherited VAPID_KEY_PATH.
ENTRYPOINT ["tini", "--"]
CMD ["/bin/sh", "-c", "\
  if [ -n \"$VAPID_PRIVATE_KEY_B64\" ]; then \
    printf '%s' \"$VAPID_PRIVATE_KEY_B64\" | base64 -d > /tmp/vapid.pem && \
    chmod 600 /tmp/vapid.pem && \
    VAPID_KEY_PATH=/tmp/vapid.pem; \
  fi; \
  /opt/pbx-cloud/pbx-cloud \
    --server-port ${PORT} \
    --server-worker ${SERVER_WORKER} \
    ${DB_URI:+--mongo-db-uri \"$DB_URI\"} \
    ${DB_POOL:+--mongo-db-connection-pool \"$DB_POOL\"} \
    ${DB_NAME:+--mongo-db-name \"$DB_NAME\"} \
    ${REMOTE_DB:+--remote-db} \
    ${AGENT_PORT:+--agent-port \"$AGENT_PORT\"} \
    ${TLS_CERT:+--tls-cert \"$TLS_CERT\"} \
    ${TLS_KEY:+--tls-key \"$TLS_KEY\"} \
    ${TLS_CA:+--tls-ca \"$TLS_CA\"} \
    ${VAPID_KEY_PATH:+--vapid-key-path \"$VAPID_KEY_PATH\"} \
    ${VAPID_SUBJECT:+--vapid-subject \"$VAPID_SUBJECT\"} \
"]
