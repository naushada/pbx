# Dockerfile.wsdbagent — on-prem WebSocket DB agent.
#
# Standalone binary that dials the Heroku-hosted cloud's /ws/db
# endpoint over wss+InnerTLS, then forwards Mongo queries to a local
# MongodbClient. Same shape as Dockerfile.agent — multi-stage,
# reuses the cached pbx-cpp-builder:bootstrap toolchain.

# ============================================================
# Stage 1: build the binary using the cached toolchain.
# ============================================================
# BUILDER_IMAGE: see Dockerfile.agent for the three-context rationale.
ARG BUILDER_IMAGE=localhost/pbx-cpp-builder:bootstrap
FROM ${BUILDER_IMAGE} AS cpp-builder

WORKDIR /src
COPY CMakeLists.txt /src/
COPY modules/      /src/modules/
COPY test/         /src/test/

WORKDIR /src/build
RUN cmake -DBUILD_TESTS=OFF -DBUILD_BINARIES=ON .. \
 && make -j"$(nproc)" wsdbagent

# ============================================================
# Stage 2: slim runtime.
# ============================================================
FROM ubuntu:focal AS runtime

ENV TZ=Asia/Calcutta DEBIAN_FRONTEND=noninteractive
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl1.1 \
        libboost-filesystem1.71.0 \
        libboost-system1.71.0 \
        libboost-thread1.71.0 \
        libzstd1 \
        libsasl2-2 \
        zlib1g \
        libicu66 \
        tini \
 && rm -rf /var/lib/apt/lists/*

COPY --from=cpp-builder /usr/local/ACE_TAO-7.0.0/lib/   /usr/local/ACE_TAO-7.0.0/lib/
RUN echo "/usr/local/ACE_TAO-7.0.0/lib" > /etc/ld.so.conf.d/ace-tao.conf
COPY --from=cpp-builder /usr/local/lib/libmongoc-1.0.so*  /usr/local/lib/
COPY --from=cpp-builder /usr/local/lib/libbson-1.0.so*    /usr/local/lib/
COPY --from=cpp-builder /usr/local/lib/libmongocxx.so*    /usr/local/lib/
COPY --from=cpp-builder /usr/local/lib/libbsoncxx.so*     /usr/local/lib/
RUN ldconfig

RUN mkdir -p /opt/wsdbagent/certs
COPY --from=cpp-builder /src/build/wsdbagent /opt/wsdbagent/wsdbagent

WORKDIR /opt/wsdbagent

# Env-driven. CLOUD_HOST + MONGO_URI are required; TLS material
# defaults to the agent's cert dir (same mount as pbx-agent). The
# Mongo DB name is `pabx` — matches the Heroku app name and what the
# cloud's --remote-db code path queries.
ENV CLOUD_HOST="" \
    CLOUD_PORT="443" \
    BACKOFF="5" \
    TLS_CERT="/opt/wsdbagent/certs/agent.crt" \
    TLS_KEY="/opt/wsdbagent/certs/agent.key" \
    TLS_CA="/opt/wsdbagent/certs/cloud-ca.pem" \
    TLS_HOSTNAME="" \
    MONGO_URI="mongodb://pbx-mongo:27017/pabx" \
    MONGO_DB_NAME="pabx" \
    MONGO_POOL="10"

ENTRYPOINT ["tini", "--"]
CMD ["/bin/sh", "-c", "\
  /opt/wsdbagent/wsdbagent \
    --server-host                \"$CLOUD_HOST\" \
    --server-port                \"$CLOUD_PORT\" \
    --backoff                    \"$BACKOFF\" \
    --tls-cert                   \"$TLS_CERT\" \
    --tls-key                    \"$TLS_KEY\" \
    --tls-ca                     \"$TLS_CA\" \
    ${TLS_HOSTNAME:+--tls-hostname \"$TLS_HOSTNAME\"} \
    --mongo-db-uri               \"$MONGO_URI\" \
    --mongo-db-name              \"$MONGO_DB_NAME\" \
    --mongo-db-connection-pool   \"$MONGO_POOL\" \
"]
