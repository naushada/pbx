# Build outputs
build/
out/
dist/
*.o
*.obj
*.a
*.so
*.dylib
*.exe

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json

# Angular / Node
node_modules/
ui/dist/
ui/.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Secrets / certs (keep templates only)
certs/*.key
certs/*.pem
certs/*.crt
# Rendered per society by scripts/setup-society.sh
certs/turnserver.conf
# DTLS cert + key emitted by setup-society.sh
certs/asterisk-dtls/
# Cloud↔agent mTLS leaf + CA pin
certs/agent-deployed/
!certs/.gitkeep
!certs/*.template

# InnerTLS material (xpmile pattern):
#   - certs/innertls/{ca,server,client}.crt — committed (public certs)
#   - certs/innertls/*.key                  — gitignored (private keys)
#   - certs/innertls/generate.sh            — committed
!certs/innertls/*.crt
!certs/innertls/generate.sh
certs/innertls/*.key
certs/innertls/*.srl

# Logs
*.log
logs/

# Docker-compose env (real values; only the .example is committed)
.env
.env.local
!.env.agent.example

# MongoDB data volumes (if a dev brings up locally outside compose)
data/
mongo-data/

# Heroku slug cache (mirrors xpmile)
.heroku-slug-cache/

# Test outputs
test-results/
coverage/
