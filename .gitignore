# Build outputs
build/
out/
dist/
*.o
*.obj
*.a
*.so
*.dylib
*.exe

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json

# Angular / Node
node_modules/
ui/dist/
ui/.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
# Claude Code local state (chat history, tool sandboxes, etc.)
.claude/

# OS
.DS_Store
Thumbs.db

# Secrets / certs (keep templates only)
certs/*.key
certs/*.pem
certs/*.crt
# Rendered per society by scripts/setup-society.sh
certs/turnserver.conf
# DTLS cert + key emitted by setup-society.sh
certs/asterisk-dtls/
# Cloud↔agent mTLS leaf + CA pin
certs/agent-deployed/
# Wsdbagent inner-TLS certs extracted from the cloud image at deploy
# time (deploy-heroku.sh cmd_extract_agent_certs). Regenerated per
# deploy — never commit the .crt/.key files. The .gitkeep below keeps
# the directory around so docker-compose.agent.yml's mount target exists
# even on a fresh clone before the first deploy.
certs/cloud-issued/*
!certs/cloud-issued/innertls/
certs/cloud-issued/innertls/*
!certs/cloud-issued/innertls/.gitkeep
!certs/cloud-issued/sip-agent/
certs/cloud-issued/sip-agent/*
!certs/cloud-issued/sip-agent/.gitkeep
# Vaadin Maven build artifacts
onprem/target/
onprem/frontend/
!certs/.gitkeep
!certs/*.template

# InnerTLS material (xpmile pattern):
#   - certs/innertls/{ca,server,client}.crt — committed (public certs)
#   - certs/innertls/*.key                  — gitignored (private keys)
#   - certs/innertls/generate.sh            — committed
!certs/innertls/*.crt
!certs/innertls/generate.sh
certs/innertls/*.key
certs/innertls/*.srl

# Logs
*.log
logs/

# Docker-compose env (real values; only the .example is committed)
.env
.env.local
!.env.agent.example

# MongoDB data volumes (if a dev brings up locally outside compose)
data/
mongo-data/

# Heroku slug cache (mirrors xpmile)
.heroku-slug-cache/

# Test outputs
test-results/
coverage/
build-lima/
.aider*
