# .env.agent.example — template for docker-compose.agent.yml.
# Copy to `.env` (gitignored) and fill in the real values for your
# society's deployment.
#
# pbx-agent's compile-time defaults already point at the compose-
# network services (pbx-asterisk:8088, pbx-mongo:27017) and the
# /opt/pbx-agent/certs/{agent.crt,agent.key,cloud-ca.pem} cert
# triple the CERTS_DIR mount lands at. That's why only a handful
# of knobs live here — the rest is baked into the binary. To
# override a default, drop a `command:` block into the pbx-agent
# service in docker-compose.agent.yml with the extra `--flag`.

# Heroku-hosted cloud endpoint (REQUIRED).
CLOUD_HOST=pabx-5fbf3550f938.herokuapp.com

# Society identifier (REQUIRED). Mongo ObjectId or short code;
# matches the society document created via `POST /api/v1/society`
# on the cloud. The agent emits this in the AGENT_HELLO frame so
# the cloud replies with the canonical sipRealm.
AGENT_SOCIETY_ID=

# Host directory with the agent's mTLS material (REQUIRED):
#   agent.crt      — client cert (signed by the same CA as the cloud)
#   agent.key      — client private key
#   cloud-ca.pem   — CA cert that signed the cloud's server cert
# Mounted read-only at /opt/pbx-agent/certs/ inside the container
# (matches main.cpp's compile-time cert-path defaults).
CERTS_DIR=./certs/agent-deployed

# Optional: SAN/CN the agent's InnerTLS handshake should verify
# the cloud cert against. Leave blank to skip the hostname check
# (the chain-of-trust check via cloud-ca.pem still runs).
INNER_TLS_HOSTNAME=

# Mongo database name. Affects pbx-wsdbagent only — pbx-agent's
# MONGO_URI is hardcoded to `mongodb://pbx-mongo:27017/pabx` (the
# DB name is part of the URI path, not parameterised here).
MONGO_DB_NAME=pabx

# Society's public TURN UDP port (society opens this in their NAT and
# DNATs to pbx-coturn). 3478 is the IANA-assigned STUN/TURN port.
TURN_PUBLIC_PORT=3478
