# .env.agent.example — template for docker-compose.agent.yml.
# Copy to `.env` (gitignored) and fill in the real values for your
# society's deployment.

# Heroku-hosted cloud endpoint.
CLOUD_HOST=pabx-5fbf3550f938.herokuapp.com
CLOUD_PORT=443

# Society identifier (Mongo ObjectId or short code; matches the
# society document created via POST /api/v1/society on the cloud).
AGENT_SOCIETY_ID=

# Host directory with the agent's mTLS material:
#   agent.crt      — client cert (signed by the same CA as the cloud)
#   agent.key      — client private key
#   cloud-ca.pem   — CA cert that signed the cloud's server cert
CERTS_DIR=./certs/agent-deployed

# Mongo database name (default: pbx).
MONGO_DB_NAME=pbx

# Asterisk ARI credentials. Override the defaults baked into the
# shipped ari.conf — they're meant for local dev only.
ARI_USER=asterisk
ARI_PASS=asterisk

# Society's public TURN UDP port (society opens this in their NAT and
# DNATs to pbx-coturn). 3478 is the IANA-assigned STUN/TURN port.
TURN_PUBLIC_PORT=3478
